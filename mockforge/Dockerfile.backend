# ==============================================================================
# Dockerfile for Real Production Backend (Container B)
# ==============================================================================
FROM node:20-alpine AS runner

WORKDIR /app

# Copy real backend implementation
COPY demos/real-backend.mjs ./real-backend.mjs

ENV NODE_ENV=production
ENV PORT=8080
ENV HOST=0.0.0.0

EXPOSE 8080

# Healthcheck
HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/health || exit 1

# Start real backend server
CMD ["node", "real-backend.mjs"]
