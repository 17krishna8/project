# ==============================================================================
# Dockerfile for MockForge Dummy Server (Container A)
# ==============================================================================
FROM node:20-alpine AS runner

WORKDIR /app

# Copy root package definitions
COPY package*.json ./
COPY packages/core/package*.json ./packages/core/
COPY packages/cli/package*.json ./packages/cli/
COPY apps/dashboard/package*.json ./apps/dashboard/

# Install dependencies
RUN npm ci --omit=dev || npm install --omit=dev

# Copy compiled code and assets
COPY packages/core/dist ./packages/core/dist
COPY packages/cli/dist ./packages/cli/dist
COPY apps/dashboard/dist ./apps/dashboard/dist
COPY samples ./samples

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

EXPOSE 3000

# Healthcheck
HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/__health || exit 1

# Start MockForge with sample spec
CMD ["node", "packages/cli/dist/index.js", "samples/tasks.yaml", "--host", "0.0.0.0", "--port", "3000"]
