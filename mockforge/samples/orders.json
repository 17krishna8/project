{
  "swagger": "2.0",
  "info": {
    "title": "Orders API",
    "version": "3.0.1",
    "description": "Swagger 2.0 JSON spec: nested line items, nullable notes, prices with two decimals."
  },
  "paths": {
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List products",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Products",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/Product" }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List orders",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Orders",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/Order" }
            }
          }
        }
      },
      "post": {
        "operationId": "createOrder",
        "summary": "Create an order",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/OrderCreate" }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": { "$ref": "#/definitions/Order" }
          }
        }
      }
    },
    "/orders/{orderId}": {
      "parameters": [
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "type": "string",
          "pattern": "^ord_[A-Za-z0-9]{6,12}$"
        }
      ],
      "get": {
        "operationId": "getOrder",
        "summary": "Read one order",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "An order",
            "schema": { "$ref": "#/definitions/Order" }
          },
          "404": { "description": "Unknown order" }
        }
      },
      "delete": {
        "operationId": "deleteOrder",
        "summary": "Delete an order",
        "responses": { "204": { "description": "Deleted" } }
      }
    }
  },
  "definitions": {
    "Product": {
      "type": "object",
      "required": ["id", "name", "price", "currency", "inStock", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^prd_[A-Za-z0-9]{6,12}$" },
        "name": { "type": "string", "minLength": 3, "maxLength": 80 },
        "price": { "type": "number", "minimum": 1, "maximum": 100000, "multipleOf": 0.01 },
        "currency": { "type": "string", "enum": ["INR", "USD", "EUR"] },
        "inStock": { "type": "boolean" },
        "tags": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "OrderCreate": {
      "type": "object",
      "required": ["customerEmail"],
      "properties": {
        "customerEmail": { "type": "string", "format": "email" },
        "customerMobile": { "type": "string", "pattern": "^(\\+91)?[6-9]\\d{9}$" },
        "note": { "type": "string", "maxLength": 200, "x-nullable": true }
      }
    },
    "Order": {
      "type": "object",
      "required": ["id", "customerEmail", "status", "total", "lineItems", "placedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^ord_[A-Za-z0-9]{6,12}$" },
        "customerEmail": { "type": "string", "format": "email" },
        "customerMobile": { "type": "string", "pattern": "^(\\+91)?[6-9]\\d{9}$" },
        "note": { "type": "string", "maxLength": 200, "x-nullable": true },
        "status": { "type": "string", "enum": ["pending", "paid", "shipped", "cancelled"] },
        "total": { "type": "number", "minimum": 0, "maximum": 500000, "multipleOf": 0.01 },
        "lineItems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["productId", "quantity", "unitPrice"],
            "properties": {
              "productId": { "type": "string", "pattern": "^prd_[A-Za-z0-9]{6,12}$" },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 20 },
              "unitPrice": { "type": "number", "minimum": 1, "maximum": 100000, "multipleOf": 0.01 }
            }
          }
        },
        "placedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
